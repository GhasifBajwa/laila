/* For screens >= 1920px (Large desktops) */
@media (min-width: 1920px) {
  nav {
  width: 90% /* Inherently responsive */;
  }

  .nav-center {
  gap: clamp(40px, 3.125rem, 60px);
  font-size: clamp(12px, 0.9375rem, 18px);
  transform: translateX(clamp(440px, 34.375rem, 660px));

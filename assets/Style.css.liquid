@font-face {
  font-family: "GT Cinetype Trial";
  src: url("{{ 'GT-Cinetype-Regular.woff2' | asset_url }}") format("woff2");
}

@font-face {
  font-family: "NewEdge666";
  src: url("{{ 'QuackeyblurRegularDemo-drJ26.otf' | asset_url }}") format("opentype");
}

@font-face {
  font-family: "CenturySchoolbook";
  src: url("{{ 'SCHLBKB.TTF' | asset_url }}") format("truetype");
}

@font-face {
  font-family: "FiraMono";
  src: url("{{ 'FiraMono-Regular.ttf' | asset_url }}") format("truetype");
}



body {
  margin: 0;
  padding: 0;
}

nav {
  position: fixed;
  width: 90vw;
  height: 3.75rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 1000;
}

.logo {
  width: 6.4rem;
  height: 2.85rem;
  margin-left: 0.625rem;
  margin-top: 0.625rem;
}

.nav-center {
  display: flex;
  gap: 2.5rem;
  font-size: clamp(12px, 1vw, 16px);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  transform: translateX(28vw);
}

.nav-center a {
  text-decoration: none;
  color: #000;
  font-weight: 500;
  font-size: clamp(12px, 1vw, 16px);
  font-family: GT Cinetype Trial;
  line-height: 1.8rem;
}

.nav-center a:hover {
  color: #999999 !important;
}

.nav-icons {
  display: flex;
  gap: 1.5rem;
  height: 1.16rem;
  width: 1.2rem;
  color: #000;
  cursor: pointer;
}

.search-input {
  position: absolute;
  top: 0.625rem;
  right: 1.25rem;
  width: 22.7rem;
  height: 2.625rem;
  padding: 0 0.9375rem;
  font-size: 0.75rem;
  font-family: GT Cinetype Trial;
  font-weight: 900;
  background-color: #EDEDEF;
  border: 1px solid #EDEDEF !important;
  display: none;
  opacity: 0;
  transform: translateX(100%);
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.search-input.visible {
  opacity: 1;
  transform: translateX(0);
}

.hero-wrapper {
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.hero {
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.img-container {
  width: 60vw;
  height: 60vh;
  transition: transform 0.1s ease-out;
  transform: scale(1);
  overflow: hidden;
}

.img-container img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 5;
  pointer-events: none;
  font-family: GT Cinetype Trial;
}

.text-left,
.text-right {
  font-size: 3rem;
  font-weight: 800;
  color: #fff;
  opacity: 0;
  transition: all 0.5s ease-out;
  white-space: nowrap;
}

.text-left {
  transform: translateX(-100%);
  margin-right: 20px;
}

.text-right {
  transform: translateX(100%);
  margin-left: 20px;
}

.active .text-left {
  transform: translateX(0);
  opacity: 1;
}

.active .text-right {
  transform: translateX(0);
  opacity: 1;
}

.spacer {
  height: 100vh;
}


/* --------- Responsive Media Queries --------- */

/* For screens <= 1366px (Common laptop size) */
@media (max-width: 1366px) {
  .nav-center {
    gap: 30px;
    font-size: 12px;
    transform: translateX(350px);
  }

  .nav-center a {
    font-size: 13px;
  }

  .search-input {
    width: 280px;
    height: 38px;
    font-size: 11px;
    right: 15px;
    top: 8px;
  }

  .img-container {
    width: 55vw;
    height: 55vh;
  }

  .text-left,
  .text-right {
    font-size: 2.5rem;
  }
}

/* For screens <= 1280px */
@media (max-width: 1280px) {
  .nav-center {
    gap: 25px;
    transform: translateX(300px);
  }

  .nav-center a {
    font-size: 12px;
  }

  .search-input {
    width: 250px;
    height: 36px;
    font-size: 11px;
    right: 12px;
    top: 7px;
  }

  .img-container {
    width: 50vw;
    height: 50vh;
  }

  .text-left,
  .text-right {
    font-size: 2.2rem;
  }
}

/* For screens <= 1024px (Small laptops, large tablets) */
@media (max-width: 1024px) {
  nav {
    width: 87%;
  }

  .nav-center {
    gap: 20px;
    font-size: 11px;
    transform: translateX(250px);
  }

  .nav-center a {
    font-size: 11px;
  }

  .search-input {
    width: 220px;
    height: 34px;
    font-size: 10px;
    right: 10px;
    top: 6px;
  }

  .img-container {
    width: 60vw;
    height: 60vh;
  }

  .img-container img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .text-left,
  .text-right {
    font-size: 1.8rem;
    margin: 0 10px;
  }
}

/* For screens >= 1920px (Large desktops) */
@media (min-width: 1920px) {
  nav {
    width: 90%;
  }

  .nav-center {
    gap: 50px;
    font-size: 15px;
    transform: translateX(550px);
  }

  .nav-center a {
    font-size: 16px;
  }

  .search-input {
    width: 400px;
    height: 44px;
    font-size: 13px;
    right: 25px;
    top: 12px;
  }

  .img-container {
    width: 65vw;
    height: 65vh;
  }

  .text-left,
  .text-right {
    font-size: 3.5rem;
  }
}


/* Updated Second Section Styles */
/* Second Section */
.second-section {
  position: relative;
  height: 200vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 0 var(--spacing-unit);
}

.collection-header {
  position: sticky;
  top: 50%;
  transform: translateY(-50%);
  z-index: -500;
  text-align: center;
  padding: var(--spacing-unit);
}

.collection-label {
  text-align: start;
  margin-left: clamp(-90px, -6vw, -50px);
  font-family: var(--font-primary);
  font-size: clamp(0.75rem, 1.2vw, 0.875rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  margin-bottom: 0.625rem;
}

.heading1 img, 
.heading2 img,
.heading3 img,
.heading4 img {
  height: auto;
  max-width: 100%;
  margin-bottom: 1.25rem;
  object-fit: cover;
}

.heading1 img { width: 324px; height: 65px; }
.heading2 img { width: 658px; height: 66px; }
.heading3 img { width: 802px; height: 83px; }
.heading4 img { width: 411px; height: 135.25px; }

.collection-subtitle {
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-primary);
  gap: 1.25rem;
  font-size: clamp(0.75rem, 1.2vw, 0.875rem);
  letter-spacing: -0.04em;
  line-height: 1.875rem;
  margin-bottom: 2.5rem;
}

.single-image-container {
  position: relative;
  width: 40%;
  max-width: 800px;
  height: 25vw;
  min-height: 300px;
  max-height: 500px;
  margin: 50vh auto;
  z-index: 1;
}

.single-image-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.collection-description {
  max-width: 37.5rem;
  margin: 1.50rem auto 0;
  font-size: clamp(1rem, 1.5vw, 1.25rem);
  font-weight: 500;
  text-align: center;
  line-height: 1;
  z-index: 0;
  font-family: var(--font-secondary);
}

/* External Section */
.extarnal-section {
  position: relative;
  height: 200vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.extarnal-text {
  position: sticky;
  top: 25%;
  transform: translateX(50%);
  z-index: 2;
  width: 90%;
  max-width: 500px;
}

.extarnal-text .img1 img { width: 409px; max-width: 100%; height: 60px; }
.extarnal-text .img2 img { width: 409px; max-width: 100%; height: 53px; }
.extarnal-text .img3 img { width: 327px; max-width: 100%; height: 59px; }

.extarnal-text h2 {
  font-size: 0.75rem;
  font-weight: 400;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 1.875rem;
  font-family: var(--font-primary);
}

.extarnal-text p {
  font-size: clamp(1rem, 1.5vw, 1.125rem);
  line-height: 1.6;
  margin-bottom: 1.875rem;
  font-family: var(--font-secondary);
}

.extarnal-text button {
  background: transparent;
  border: 1px solid var(--color-black);
  font-family: var(--font-primary);
  font-size: 0.875rem;
  font-weight: 400;
  cursor: pointer;
  transition: background 0.3s ease, color 0.3s ease;
  padding: 0.5em 1em;
}

.extarnal-text button:hover {
  background: #111;
  color: #fff;
}

.extarnal-image {
  transform: translateX(-65%);
  margin-top: 31.25rem;
  width: 100%;
  max-width: 525px;
}

.extarnal-image img {
  width: 100%;
  height: auto;
  max-height: 785px;
  object-fit: cover;
}

/* Last Section */
.last-section {
  font-family: "Helvetica Neue", sans-serif;
  display: flex;
  flex-direction: column;
  align-items: center;
  /* justify-content: center; */
  padding: 3.75rem 1.25rem;
}

.img4 img, .img5 img {
  max-width: 100%;
  height: auto;
  object-fit: cover;
}

.img4 img { width: 411px; height: 71px; }
.img5 img { width: 651px; height: 71px; }

.subheading {
  margin-top: 1.25rem;
  font-size: clamp(1rem, 2vw, 1.25rem);
  font-weight: 400;
  line-height: 1;
  width: 100%;
  max-width: 578px;
  font-family: var(--font-secondary);
  letter-spacing: 0.02em;
}

.button-container {
  width: 11.25rem;
  height: 2.3125rem;
}

.button {
  font-size: 0.875rem;
  font-family: var(--font-primary);
  font-weight: 400;
  border: 1px solid var(--color-black);
  background-color: transparent;
  cursor: pointer;
  transition: background 0.3s;
  width: 100%;
  height: 100%;
  padding: 0;
}

.button:hover {
  background-color: var(--color-black);
  color: var(--color-white);
}

.image {
  margin: 2.5rem 0 4.6875rem;
  width: 100%;
  max-width: 627px;
  height: auto;
  aspect-ratio: 627 / 427;
  object-fit: cover;
}
.footer {
  margin-top: 1.5625rem; /* 25px / 16px */
  background-color: #e7e7e7;
  padding: 2.5rem 3.75rem; /* 40px / 16px, 60px / 16px */
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  font-size: 0.75rem; /* 12px / 16px */
  font-family: monospace;
}

.footer-column {
  flex: 1;
  min-width: 11.25rem; /* 180px / 16px */
  margin-bottom: 1.25rem; /* 20px / 16px */
}

.footer-column h4 {
  margin: 0 0 0.625rem; /* 10px / 16px */
  font-weight: 400;
  font-size: 0.875rem; /* 14px / 16px */
  line-height: 1.875rem; /* 30px / 16px */
  letter-spacing: -0.035rem; /*-4% of 14px in rems */
  font-family: FiraMono;
}

.footer-column ul {
  list-style: none;
  padding: 0;
  margin: 0;
  font-weight: 400;
  font-size: 0.875rem; /* 14px / 16px */
  line-height: 1.875rem; /* 30px / 16px */
   letter-spacing: -0.035rem; /*-4% of 14px in rems */
  font-family: FiraMono;
}

.footer-column ul li {
  margin: 0.3125rem 0; /* 5px / 16px */
  font-weight: 400;
  font-size: 0.875rem; /* 14px / 16px */
  line-height: 1.875rem; /* 30px / 16px */
   letter-spacing: -0.035rem; /*-4% of 14px in rems */
  font-family: FiraMono;
}

.footer-column p {
  margin: 0.3125rem 0; /* 5px / 16px */
  font-weight: 400;
  font-size: 0.875rem; /* 14px / 16px */
  line-height: 1.875rem; /* 30px / 16px */
   letter-spacing: -0.035rem; /*-4% of 14px in rems */
  font-family: FiraMono;
}

.social-icons {
  display: flex;
  gap: 0.625rem; /* 10px / 16px */
  margin-top: 0.625rem; /* 10px / 16px */
}

.social-icons img {
  width: 1.8125rem; /* 29px / 16px */
  height: 1.8125rem; /* 29px / 16px */
}

.social-icons .group {
  margin-top: 0.125rem; /* 2px / 16px */
  width: 2.125rem; /* 34px / 16px */
  height: 1.5rem; /* 24px / 16px */
}

/* Media Queries for Responsiveness */
@media (max-width: 768px) {
  .footer {
    padding: 1.25rem; /* Reduced padding for smaller screens */
  }

  .footer-column {
    min-width: 100%;
    margin-bottom: 1rem;
  }
}

@media (max-width: 576px) {
  .footer {
    flex-direction: column; /* Stack columns on very small screens */
    align-items: center;
  }

  .footer-column {
    text-align: center;
  }
  .social-icons {
  display: flex;
  justify-content: center;
    align-items: center;
}
}

/* Shope page */

.Filter-nav {
  padding-top: 70px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.Filter-nav-links {
  margin-left: -20px;
  list-style: none;
  display: flex;
  gap: 35px;
}

.Filter-nav-links li a {
  text-decoration: none;
  color: #000;
  font-weight: 900;
  font-size: 14px;
  font-family: GT Cinetype Trial;
  line-height: 30px;
  letter-spacing: -4%;
}

.filter {
  display: flex;
  align-items: center;
  justify-content: end;
  gap: 15px;
  margin-top: 10px;
}

.filter span {
  margin-top: -15px;
  margin-right: 30px;
  font-weight: 900;
  font-size: 14px;
  font-family: GT Cinetype Trial;
  line-height: 30px;
  letter-spacing: -4%;
}

.filter img {
  height: 47px;
  width: 33px;
  object-fit: cover;
}

.name {
  font-weight: 900;
  font-size: 14px;
  font-family: GT Cinetype Trial;
  margin-top: 10px;
  line-height: 30px;
  letter-spacing: -4%;
}

.price {
  font-weight: 900;
  font-size: 14px;
  font-family: GT Cinetype Trial;
  line-height: 30px;
  letter-spacing: -4%;
}

.product img {
    max-width: 100%; /* Make image responsive */
    height: auto;
    aspect-ratio: 365 / 340; /* Maintain original aspect ratio */
    object-fit: cover;
}

.gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15.625rem, 1fr)); /* Default: Flexible columns */
    gap: 0.3125rem;
    padding: 0.9375rem;
}

/* Tablet (adjust if needed) */
@media (max-width: 768px) {
    .gallery {
        grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); /* Slightly smaller min-width */
    }
}

/* Mobile (force 2 columns) */
@media (max-width: 480px) {
    .gallery {
        grid-template-columns: repeat(2, 1fr) !important; /* Fixed 2 columns */
    }
  .product img {
    max-width: 100%; /* Make image responsive */
    height: auto;
    aspect-ratio: 365 / 340; /* Maintain original aspect ratio */
    object-fit: cover;
}
  .Filter-nav-links {
  margin-left: -20px;
  list-style: none;
  display: flex;
  gap: 15px;
}
}

/* Desktop (optional) */
@media (min-width: 1200px) {
    .gallery {
        grid-template-columns: repeat(4, 1fr); /* Fixed 4 columns */
    }
}

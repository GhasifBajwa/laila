body {
  margin: 0;
  padding: 0;
}

nav {
  position: fixed;
  width: 90vw /* Inherently responsive */;
  height: 3.75rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 1000;
}

.logo {
  width: 6.4rem;
  height: 2.85rem;
  margin-left: 0.625rem;
  margin-top: 0.625rem;
}

.nav-center {
  display: flex;
  gap: 2.5rem;
  font-size: clamp(clamp(10px, 0.75rem, 14px), 1vw, clamp(13px, 1rem, 19px));
  text-transform: uppercase;
  letter-spacing: 0.clamp(4px, 0.3125rem, 6px);
  transform: translateX(28vw);
}

.nav-center a {
  text-decoration: none;
  color: #000;
  font-weight: 500;
  font-size: clamp(clamp(10px, 0.75rem, 14px), 1vw, clamp(13px, 1rem, 19px));
  font-family: GT Cinetype Trial;
  line-height: 1.8rem;
}

.nav-center a:hover {
  color: #999999 !important;
}

.nav-icons {
  display: flex;
  gap: 1.5rem;
  height: 1.16rem;
  width: 1.2rem;
  color: #000;
  cursor: pointer;
}

.search-input {
  position: absolute;
  top: 0.625rem;
  right: 1.25rem;
  width: 22.7rem;
  height: 2.625rem;
  padding: 0 0.9375rem;
  font-size: 0.75rem;
  font-family: GT Cinetype Trial;
  font-weight: 900;
  background-color: #EDEDEF;
  border: 1px solid #EDEDEF !important;
  display: none;
  opacity: 0;
  transform: translateX(100%);
  transition: opacity 0.3s ease, transform 0.3s ease /* Respects user motion preferences */;
}

.search-input.visible {
  opacity: 1;
  transform: translateX(0);
}

.hero-wrapper {
  height: 100vh /* Inherently responsive */;
  position: relative;
  overflow: hidden;
}

.hero {
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh /* Inherently responsive */;
  width: 100% /* Inherently responsive */;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.img-container {
  width: 60vw /* Inherently responsive */;
  height: 60vh /* Inherently responsive */;
  transition: transform 0.1s ease-out /* Respects user motion preferences */;
  transform: scale(1);
  overflow: hidden;
}

.img-container img {
  width: 100% /* Inherently responsive */;
  height: 100% /* Inherently responsive */;
  display: block;
}

.hero-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100% /* Inherently responsive */;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 5;
  pointer-events: none;
  font-family: GT Cinetype Trial;
}

.text-left,
.text-right {
  font-size: 3rem;
  font-weight: 800;
  color: white;
  opacity: 0;
  transition: all 0.5s ease-out /* Respects user motion preferences */;
  white-space: nowrap;
}

.text-left {
  transform: translateX(-100%);
  margin-right: clamp(16px, 1.25rem, 24px);
}

.text-right {
  transform: translateX(100%);
  margin-left: clamp(16px, 1.25rem, 24px);
}

.active .text-left {
  transform: translateX(0);
  opacity: 1;
}

.active .text-right {
  transform: translateX(0);
  opacity: 1;
}

.spacer {
  height: 100vh /* Inherently responsive */;
}


/* --------- Responsive Media Queries --------- */

/* For screens <= 1366px (Common laptop size) */
@media (max-width: 1366px) {
  .nav-center {
  gap: clamp(24px, 1.875rem, 36px);
  font-size: clamp(10px, 0.75rem, 14px);
  transform: translateX(clamp(280px, 21.875rem, 420px));
  }

  .nav-center a {
  font-size: clamp(10px, 0.8125rem, 16px);
  }

  .search-input {
  width: clamp(224px, 17.5rem, 336px);
  height: clamp(30px, 2.375rem, 46px);
  font-size: clamp(9px, 0.6875rem, 13px);
  right: clamp(12px, 0.9375rem, 18px);
  top: clamp(6px, 0.5rem, 10px);
  }

  .img-container {
  width: 55vw /* Inherently responsive */;
  height: 55vh /* Inherently responsive */;
  }

  .text-left,
  .text-right {
  font-size: 2.5rem;
  }
}


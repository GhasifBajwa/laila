  right: clamp(10px, 0.75rem, 14px);
  top: clamp(6px, 0.4375rem, 8px);
  }

  .img-container {
  width: 50vw /* Inherently responsive */;
  height: 50vh /* Inherently responsive */;
  }

  .text-left,
  .text-right {
  font-size: 2.2rem;
  }
}

/* For screens <= 1024px (Small laptops, large tablets) */
@media (max-width: 1024px) {
  nav {
  width: 87% /* Inherently responsive */;
  }

  .nav-center {
  gap: clamp(16px, 1.25rem, 24px);
  font-size: clamp(9px, 0.6875rem, 13px);
  transform: translateX(clamp(200px, 15.625rem, 300px));
  }

  .nav-center a {
  font-size: clamp(9px, 0.6875rem, 13px);
  }

  .search-input {
  width: clamp(176px, 13.75rem, 264px);
  height: clamp(27px, 2.125rem, 41px);

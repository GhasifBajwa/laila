        font-family: GT Cinetype Trial;
        font-size: 14px;
        font-weight: 900;
        cursor: pointer;
        text-transform: uppercase;
      }

      .open-bag {
        cursor: pointer;
      }

      .x-close {
        color: red;
        font-family: GT Cinetype Trial;
        font-size: 14px;
        font-weight: 900;
        cursor: pointer;
      }
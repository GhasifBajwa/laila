/* Shope page */

.Filter-nav {
  padding-top: clamp(56px, 4.375rem, 84px);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.Filter-nav-links {
  margin-left: -clamp(16px, 1.25rem, 24px);
  list-style: none;
  display: flex;
  gap: clamp(28px, 2.1875rem, 42px);
}

.Filter-nav-links li a {
  text-decoration: none;
  color: #000;
  font-weight: 900;
  font-size: clamp(11px, 0.875rem, 17px);
  font-family: GT Cinetype Trial;
  line-height: clamp(24px, 1.875rem, 36px);
  letter-spacing: -4%;
}

.filter {
  display: flex;
  align-items: center;
  justify-content: end;
  gap: clamp(12px, 0.9375rem, 18px);
  margin-top: clamp(8px, 0.625rem, 12px);
}

.filter span {
  margin-top: -clamp(12px, 0.9375rem, 18px);
  margin-right: clamp(24px, 1.875rem, 36px);
  font-weight: 900;
  font-size: clamp(11px, 0.875rem, 17px);
  font-family: GT Cinetype Trial;
  line-height: clamp(24px, 1.875rem, 36px);
  letter-spacing: -4%;
}

.filter img {
  height: clamp(38px, 2.9375rem, 56px);
  width: clamp(26px, 2.0625rem, 40px);
  object-fit: cover;
}

.name {
  font-weight: 900;
  font-size: clamp(11px, 0.875rem, 17px);
  font-family: GT Cinetype Trial;
  margin-top: clamp(8px, 0.625rem, 12px);
  line-height: clamp(24px, 1.875rem, 36px);
  letter-spacing: -4%;
}

.price {
  font-weight: 900;
  font-size: clamp(11px, 0.875rem, 17px);
  font-family: GT Cinetype Trial;
  line-height: clamp(24px, 1.875rem, 36px);
  letter-spacing: -4%;
}

.product img {
  max-width: 100% /* Make image responsive */ /* Inherently responsive */;
  height: auto;
  aspect-ratio: 365 / 340 /* Maintain original aspect ratio */;
  object-fit: cover;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(15.625rem, 1fr)) /* Default;
  gap: 0.3125rem;
  padding: 0.9375rem;
}

/* Tablet (adjust if needed) */
@media (max-width: 768px) {
    .gallery {
  grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)) /* Slightly smaller min-width */;
    }
}

/* Mobile (force 2 columns) */
@media (max-width: 480px) {
    .gallery {
  grid-template-columns: repeat(2, 1fr) !important /* Fixed 2 columns */;
    }
  .product img {
  max-width: 100% /* Make image responsive */ /* Inherently responsive */;
  height: auto;
  aspect-ratio: 365 / 340 /* Maintain original aspect ratio */;
  object-fit: cover;
}
  .Filter-nav-links {
  margin-left: -clamp(16px, 1.25rem, 24px);
  list-style: none;
  display: flex;
  gap: clamp(12px, 0.9375rem, 18px);
}
}

/* Desktop (optional) */
@media (min-width: 1200px) {
    .gallery {
  grid-template-columns: repeat(4, 1fr) /* Fixed 4 columns */;
    }
}

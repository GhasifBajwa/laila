/* Base Font Definitions */
@font-face {
  font-family: "GT Cinetype Trial";
  src: url("{{ 'GT-Cinetype-Regular.woff2' | asset_url }}") format("woff2");
}

@font-face {
  font-family: "NewEdge666";
  src: url("{{ 'QuackeyblurRegularDemo-drJ26.otf' | asset_url }}") format("opentype");
}

@font-face {
  font-family: "CenturySchoolbook";
  src: url("{{ 'SCHLBKB.TTF' | asset_url }}") format("truetype");
}

@font-face {
  font-family: "FiraMono";
  src: url("{{ 'FiraMono-Regular.ttf' | asset_url }}") format("truetype");
}

/* Base Styles */
:root {
  --font-primary: "GT Cinetype Trial", sans-serif;
  --font-secondary: "CenturySchoolbook", serif;
  --font-mono: "FiraMono", monospace;
  --color-text: #333;
  --color-white: #fff;
  --color-black: #000;
  --spacing-unit: 1rem;
  --max-width: 1440px;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 0;
  font-size: 16px;
  line-height: 1.5;
  color: var(--color-text);
  overflow-x: hidden;
}

img {
  max-width: 100%;
  height: auto;
}

/* Hero Section */
.hero-wrapper {
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.hero {
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.img-container {
  width: 60vw;
  height: 60vh;
  max-width: 900px;
  max-height: 600px;
  transition: transform 0.1s ease-out;
  transform: scale(1);
  overflow: hidden;
}

.hero-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 5;
  pointer-events: none;
  font-family: var(--font-primary);
}

.text-left,
.text-right {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 800;
  color: var(--color-white);
  opacity: 0;
  transition: all 0.5s ease-out;
  white-space: nowrap;
}

.text-left {
  transform: translateX(-100%);
  margin-right: 1.25rem;
}

.text-right {
  transform: translateX(100%);
  margin-left: 1.25rem;
}

.active .text-left,
.active .text-right {
  transform: translateX(0);
  opacity: 1;
}

.spacer {
  height: 100vh;
}

/* Second Section */
.second-section {
  position: relative;
  height: 200vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 0 var(--spacing-unit);
}

.collection-header {
  position: sticky;
  top: 50%;
  transform: translateY(-50%);
  z-index: -500;
  text-align: center;
  padding: var(--spacing-unit);
}

.collection-label {
  text-align: start;
  margin-left: clamp(-90px, -6vw, -50px);
  font-family: var(--font-primary);
  font-size: clamp(0.75rem, 1.2vw, 0.875rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  margin-bottom: 0.625rem;
}

.heading1 img, 
.heading2 img,
.heading3 img,
.heading4 img {
  height: auto;
  max-width: 100%;
  margin-bottom: 1.25rem;
  object-fit: cover;
}

.heading1 img { width: 324px; height: 65px; }
.heading2 img { width: 658px; height: 66px; }
.heading3 img { width: 802px; height: 83px; }
.heading4 img { width: 411px; height: 135.25px; }

.collection-subtitle {
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-primary);
  gap: 1.25rem;
  font-size: clamp(0.75rem, 1.2vw, 0.875rem);
  letter-spacing: -0.04em;
  line-height: 1.875rem;
  margin-bottom: 2.5rem;
}

.single-image-container {
  position: relative;
  width: 40%;
  max-width: 800px;
  height: 25vw;
  min-height: 300px;
  max-height: 500px;
  margin: 45vh auto;
  z-index: 1;
}

.single-image-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.collection-description {
  max-width: 37.5rem;
  margin: 1.25rem auto 0;
  font-size: clamp(1rem, 1.5vw, 1.25rem);
  font-weight: 500;
  text-align: center;
  line-height: 1;
  z-index: 0;
  font-family: var(--font-secondary);
}

/* External Section */
.extarnal-section {
  position: relative;
  height: 200vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.extarnal-text {
  position: sticky;
  top: 25%;
  transform: translateX(50%);
  z-index: 2;
  width: 90%;
  max-width: 500px;
}

.extarnal-text .img1 img { width: 409px; max-width: 100%; height: 60px; }
.extarnal-text .img2 img { width: 409px; max-width: 100%; height: 53px; }
.extarnal-text .img3 img { width: 327px; max-width: 100%; height: 59px; }

.extarnal-text h2 {
  font-size: 0.75rem;
  font-weight: 400;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 1.875rem;
  font-family: var(--font-primary);
}

.extarnal-text p {
  font-size: clamp(1rem, 1.5vw, 1.125rem);
  line-height: 1.6;
  margin-bottom: 1.875rem;
  font-family: var(--font-secondary);
}

.extarnal-text button {
  background: transparent;
  border: 1px solid var(--color-black);
  font-family: var(--font-primary);
  font-size: 0.875rem;
  font-weight: 400;
  cursor: pointer;
  transition: background 0.3s ease, color 0.3s ease;
  padding: 0.5em 1em;
}

.extarnal-text button:hover {
  background: #111;
  color: #fff;
}

.extarnal-image {
  transform: translateX(-65%);
  margin-top: 31.25rem;
  width: 100%;
  max-width: 525px;
}

.extarnal-image img {
  width: 100%;
  height: auto;
  max-height: 785px;
  object-fit: cover;
}

/* Last Section */
.last-section {
  font-family: "Helvetica Neue", sans-serif;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 3.75rem 1.25rem;
}

.img4 img, .img5 img {
  max-width: 100%;
  height: auto;
  object-fit: cover;
}

.img4 img { width: 411px; height: 71px; }
.img5 img { width: 651px; height: 71px; }

.subheading {
  margin-top: 1.25rem;
  font-size: clamp(1rem, 2vw, 1.25rem);
  font-weight: 400;
  line-height: 1;
  width: 100%;
  max-width: 578px;
  font-family: var(--font-secondary);
  letter-spacing: 0.02em;
  text-align: center;
}

.button-container {
  margin: -2.5rem 0 0;
  width: 11.25rem;
  height: 2.3125rem;
}

.button {
  font-size: 0.875rem;
  font-family: var(--font-primary);
  font-weight: 400;
  border: 1px solid var(--color-black);
  background-color: transparent;
  cursor: pointer;
  transition: background 0.3s;
  width: 100%;
  height: 100%;
  padding: 0;
}

.button:hover {
  background-color: var(--color-black);
  color: var(--color-white);
}

.image {
  margin: 2.5rem 0 4.6875rem;
  width: 100%;
  max-width: 627px;
  height: auto;
  aspect-ratio: 627 / 427;
  object-fit: cover;
}

/* Footer */
.footer {
  margin-top: 1.5625rem;
  background-color: #e7e7e7;
  padding: 2.5rem 3.75rem;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  font-size: 0.75rem;
}

.footer-column {
  flex: 1;
  min-width: 11.25rem;
  margin-bottom: 1.25rem;
}

.footer-column h4 {
  margin: 0 0 0.625rem;
  font-weight: 400;
  font-size: 0.875rem;
  line-height: 1.875rem;
  letter-spacing: -0.035rem;
  font-family: var(--font-mono);
}

.footer-column ul {
  list-style: none;
  padding: 0;
  margin: 0;
  font-weight: 400;
  font-size: 0.875rem;
  line-height: 1.875rem;
  letter-spacing: -0.035rem;
  font-family: var(--font-mono);
}

.footer-column ul li {
  margin: 0.3125rem 0;
}

.footer-column p {
  margin: 0.3125rem 0;
  font-weight: 400;
  font-size: 0.875rem;
  line-height: 1.875rem;
  letter-spacing: -0.035rem;
  font-family: var(--font-mono);
}

.social-icons {
  display: flex;
  gap: 0.625rem;
  margin-top: 0.625rem;
}

.social-icons img {
  width: 1.8125rem;
  height: 1.8125rem;
}

/* Shop Page */
.Filter-nav {
  padding-top: 4.375rem;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1rem;
  padding: 4.375rem 1.25rem 0;
}

.Filter-nav-links {
  margin: 0;
  padding: 0;
  list-style: none;
  display: flex;
  gap: clamp(0.9375rem, 3vw, 2.1875rem);
  flex-wrap: wrap;
}

.Filter-nav-links li a {
  text-decoration: none;
  color: var(--color-black);
  font-weight: 900;
  font-size: 0.875rem;
  font-family: var(--font-primary);
  line-height: 1.875rem;
  letter-spacing: -0.04em;
}

.filter {
  display: flex;
  align-items: center;
  gap: 0.9375rem;
}

.filter span {
  font-weight: 900;
  font-size: 0.875rem;
  font-family: var(--font-primary);
  line-height: 1.875rem;
  letter-spacing: -0.04em;
}

.filter img {
  height: 2.9375rem;
  width: 2.0625rem;
  object-fit: cover;
}

.name, .price {
  font-weight: 900;
  font-size: 0.875rem;
  font-family: var(--font-primary);
  line-height: 1.875rem;
  letter-spacing: -0.04em;
  margin: 0.625rem 0;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.625rem), 1fr));
  gap: 0.3125rem;
  padding: 0.9375rem;
}

.product img {
  width: 100%;
  height: auto;
  aspect-ratio: 365 / 340;
  object-fit: cover;
}

/* Collection Gallery */
.gallery_Collection {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(15.625rem, 1fr));
  gap: 2.5rem 3.75rem;
  text-align: center;
  padding: 4.375rem 1.25rem !important;
}

.item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.item img {
  width: 100%;
  height: auto;
  max-width: 482px;
  aspect-ratio: 1;
  object-fit: cover;
  border: 1px solid #ccc;
  transition: transform 0.2s ease;
}

.item1 img { aspect-ratio: 1; }
.item2 img { aspect-ratio: 205 / 250; }
.item3 img { aspect-ratio: 482 / 250; }
.item4 img { aspect-ratio: 347 / 227; }
.item5 img { aspect-ratio: 230 / 290; }
.item6 img { aspect-ratio: 258 / 264; }

.caption {
  margin-top: 0.625rem;
  font-size: 0.875rem;
  font-weight: 900;
  letter-spacing: -0.04em;
  font-family: var(--font-primary);
  line-height: 1.875rem;
}

/* About Page */
.section-about {
  max-width: 62.5rem;
  margin: 0 auto 6.25rem;
  padding: 9.375rem 1.25rem 0;
}

.story {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
}

.about-img {
  width: 100%;
  max-width: 21.875rem;
  height: auto;
  aspect-ratio: 350 / 415;
}

.story-text {
  margin-top: 4.6875rem;
}

.story-text img {
  margin-bottom: 1.25rem;
  width: 12.5rem;
  height: auto;
}

.story-text p {
  font-size: clamp(1rem, 2vw, 1.25rem);
  max-width: 34.375rem;
  font-weight: 500;
  font-family: var(--font-secondary);
  line-height: 1;
}

.timeless {
  max-width: 43.75rem;
  margin: 18.75rem auto 0;
  padding: 0 1.25rem;
}

.timeless img {
  margin-left: 6.25rem;
  width: 15.625rem;
  height: auto;
  margin-bottom: 1.5625rem;
}

.timeless p {
  font-size: clamp(1rem, 2vw, 1.25rem);
  max-width: 34.375rem;
  font-weight: 500;
  font-family: var(--font-secondary);
  line-height: 1;
}

/* Cart Modal */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.5);
  display: none;
  z-index: 9;
}

.cart-modal {
  position: fixed;
  top: 0;
  right: -25rem;
  width: 100%;
  max-width: 25rem;
  height: 100vh;
  background: #fff;
  box-shadow: -2px 0 10px rgba(0, 0, 0, 0.2);
  transition: right 0.3s ease;
  z-index: 10;
  display: flex;
  flex-direction: column;
  font-size: 0.8125rem;
}

.cart-modal.open {
  right: 0;
}

.overlay.show {
  display: block;
}

.cart-header,
.cart-footer {
  padding: 0.625rem 0.9375rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #000;
}

.cart-header {
  font-weight: bold;
  text-transform: uppercase;
  font-family: var(--font-primary);
}

.cart-body {
  flex: 1;
  overflow-y: auto;
}

.cart-item {
  display: flex;
  border-bottom: 1px solid #000;
}

.cart-item img {
  width: 50%;
  object-fit: cover;
}

.item-info {
  padding: 0.625rem;
  width: 50%;
}

.item-info p {
  margin: 0.125rem 0;
  font-family: var(--font-primary);
}

.remove {
  color: red;
  font-family: var(--font-primary);
  font-size: 0.875rem;
  font-weight: 900;
  cursor: pointer;
  margin-top: 0.3125rem;
}

.checkout-section {
  border-top: 1px solid #000;
  padding: 0.9375rem;
}

.checkout-section .total-label {
  font-family: var(--font-primary);
  font-size: 0.875rem;
  font-weight: 900;
  text-transform: uppercase;
  color: #666;
}

.checkout-section .total-amount {
  font-family: var(--font-primary);
  font-size: 0.875rem;
  font-weight: 900;
  margin-bottom: 0.625rem;
}

.checkout-button {
  background-color: #e94f35;
  color: white;
  border: none;
  width: 100%;
  padding: 0.75rem;
  font-family: var(--font-primary);
  font-size: 0.875rem;
  font-weight: 900;
  cursor: pointer;
  text-transform: uppercase;
}

.x-close {
  color: red;
  font-family: var(--font-primary);
  font-size: 0.875rem;
  font-weight: 900;
  cursor: pointer;
}

/* Responsive Adjustments */
@media (max-width: 1024px) {
  .img-container {
    width: 70vw;
    height: 50vh;
  }
  
  .single-image-container {
    width: 60%;
    margin: 35vh auto;
  }
  
  .extarnal-text {
    transform: translateX(30%);
  }
  
  .extarnal-image {
    transform: translateX(-50%);
  }
}

@media (max-width: 768px) {
  .img-container {
    width: 80vw;
    height: 45vh;
  }
  
  .text-left, 
  .text-right {
    white-space: normal;
    text-align: center;
    margin: 0 0.625rem;
  }
  
  .single-image-container {
    width: 80%;
    margin: 30vh auto;
  }
  
  .extarnal-section {
    flex-direction: column;
    height: auto;
    padding: 5rem 1.25rem;
  }
  
  .extarnal-text {
    position: static;
    transform: none;
    width: 100%;
    margin-bottom: 2.5rem;
  }
  
  .extarnal-image {
    transform: none;
    margin: 0;
    max-width: 100%;
  }
  
  .gallery {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .gallery_Collection {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  
  .story {
    flex-direction: column;
  }
  
  .about-img {
    max-width: 100%;
  }
}

@media (max-width: 480px) {
  .img-container {
    width: 90vw;
    height: 40vh;
  }
  
  .hero-text {
    flex-direction: column;
  }
  
  .text-left,
  .text-right {
    margin: 0.3125rem 0;
    font-size: 1.5rem;
  }
  
  .collection-label {
    margin-left: 0;
    text-align: center;
  }
  
  .single-image-container {
    width: 90%;
    height: 30vh;
    margin: 25vh auto;
  }
  
  .gallery_Collection {
    grid-template-columns: 1fr;
  }
  
  .cart-modal {
    width: 100%;
    max-width: none;
  }
}

/* Zoom Resilience */
@media (min-width: 1920px) {
  body {
    font-size: 18px;
  }
  
  .img-container {
    max-width: 1000px;
    max-height: 700px;
  }
}

@media (min-width: 2560px) {
  body {
    font-size: 20px;
  }
  
  .img-container {
    max-width: 1200px;
    max-height: 800px;
  }
}
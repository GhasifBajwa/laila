.overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw /* Inherently responsive */;
  height: 100vh /* Inherently responsive */;
  background: rgba(0, 0, 0, 0.5);
  display: none;
  z-index: 9;
      }

      /* Modal Sidebar */
      .cart-modal {
  position: fixed;
  top: 0;
  right: -clamp(320px, 25rem, 480px);
  width: clamp(320px, 25rem, 480px);
  height: 100vh /* Inherently responsive */;
  background: #fff;
  box-shadow: -2px 0 clamp(8px, 0.625rem, 12px) rgba(0, 0, 0, 0.2);
  transition: right 0.3s ease /* Respects user motion preferences */;
  z-index: 10;
  display: flex;
  flex-direction: column;
  font-size: clamp(10px, 0.8125rem, 16px);
      }

      .cart-modal.open {
  right: 0;
      }

      .overlay.show {
  display: block;
      }

      .cart-header,
      .cart-footer {
  padding: clamp(8px, 0.625rem, 12px) clamp(12px, 0.9375rem, 18px);
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #000;
      }


/* Auto-generated responsive CSS */
/* Optimized for all screen sizes and zoom levels */

@font-face {
  font-family: "GT Cinetype Trial";
  src: url("{{ 'GT-Cinetype-Regular.woff2' | asset_url }}") format("woff2");
}

@font-face {
  font-family: "NewEdge666";
  src: url("{{ 'QuackeyblurRegularDemo-drJ26.otf' | asset_url }}") format("opentype");
}

@font-face {
  font-family: "CenturySchoolbook";
  src: url("{{ 'SCHLBKB.TTF' | asset_url }}") format("truetype");
}

@font-face {
  font-family: "FiraMono";
  src: url("{{ 'FiraMono-Regular.ttf' | asset_url }}") format("truetype");
}



body {
  margin: 0;
  padding: 0;
}

nav {
  position: fixed;
  width: clamp(288px, 90vw, 1728px);
  height: 3.75rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 1000;
}

.logo {
  width: 6.4rem;
  height: 2.85rem;
  margin-left: 0.625rem;
  margin-top: 0.625rem;
}

.nav-center {
  display: flex;
  gap: 2.5rem;
  font-size: clamp(clamp(7px, 0.75rem + 0.12vw, 22px), 1vw, clamp(10px, 1rem + 0.16vw, 29px));
  text-transform: uppercase;
  letter-spacing: 0.clamp(3px, 0.3125rem + 0.05vw, 9px);
  transform: translateX(28vw);
}

.nav-center a {
  text-decoration: none;
  color: #000;
  font-weight: 500;
  font-size: clamp(clamp(7px, 0.75rem + 0.12vw, 22px), 1vw, clamp(10px, 1rem + 0.16vw, 29px));
  font-family: GT Cinetype Trial;
  line-height: 1.8rem;
}

.nav-center a:hover {
  color: #999999 !important;
}

.nav-icons {
  display: flex;
  gap: 1.5rem;
  height: 1.16rem;
  width: 1.2rem;
  color: #000;
  cursor: pointer;
}

.search-input {
  position: absolute;
  top: 0.625rem;
  right: 1.25rem;
  width: 22.7rem;
  height: 2.625rem;
  padding: 0 0.9375rem;
  font-size: clamp(52.5rem, 75rem + 0.5vw, 135rem);
  font-family: GT Cinetype Trial;
  font-weight: 900;
  background-color: #EDEDEF;
  border: 1px solid #EDEDEF !important;
  display: none;
  opacity: 0;
  transform: translateX(100%);
  transition: opacity 0.3s ease, transform 0.3s ease /* Respects user motion preferences */;
}

.search-input.visible {
  opacity: 1;
  transform: translateX(0);
}

.hero-wrapper {
  height: clamp(480px, 100vh, 1080px);
  position: relative;
  overflow: hidden;
}

.hero {
  position: fixed;
  top: 0;
  left: 0;
  height: clamp(480px, 100vh, 1080px);
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.img-container {
  width: clamp(192px, 60vw, 1152px);
  height: clamp(288px, 60vh, 648px);
  transition: transform 0.1s ease-out /* Respects user motion preferences */;
  transform: scale(1);
  overflow: hidden;
}

.img-container img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 5;
  pointer-events: none;
  font-family: GT Cinetype Trial;
}

.text-left,
.text-right {
  font-size: clamp(2.0999999999999996rem, 3rem + 0.5vw, 5.4rem);
  font-weight: 800;
  color: white;
  opacity: 0;
  transition: all 0.5s ease-out /* Respects user motion preferences */;
  white-space: nowrap;
}

.text-left {
  transform: translateX(-100%);
  margin-right: clamp(12px, 1.25rem + clamp(1px, 0.2vw, 4px), 36px);
}

.text-right {
  transform: translateX(100%);
  margin-left: clamp(12px, 1.25rem + clamp(1px, 0.2vw, 4px), 36px);
}

.active .text-left {
  transform: translateX(0);
  opacity: 1;
}

.active .text-right {
  transform: translateX(0);
  opacity: 1;
}

.spacer {
  height: clamp(480px, 100vh, 1080px);
}


/* --------- Responsive Media Queries --------- */

/* For screens <= 1366px (Common laptop size) */
@media (max-width: 1366px) {
  .nav-center {
  gap: clamp(18px, 1.875rem + 0.3vw, 54px);
  font-size: clamp(7px, 0.75rem + 0.12vw, 22px);
  transform: translateX(clamp(210px, 21.875rem + 3.5vw, 630px));
  }

  .nav-center a {
  font-size: clamp(8px, 0.8125rem + 0.13vw, 23px);
  }

  .search-input {
  width: clamp(168px, 17.5rem + clamp(9px, 2.8vw, 54px), 504px);
  height: clamp(23px, 2.375rem + clamp(1px, 0.38vw, 7px), 68px);
  font-size: clamp(7px, 0.6875rem + 0.11vw, 20px);
  right: clamp(9px, 0.9375rem + 0.15vw, 27px);
  top: clamp(5px, 0.5rem + 0.08vw, 14px);
  }

  .img-container {
  width: clamp(176px, 55vw, 1056px);
  height: clamp(264px, 55vh, 594px);
  }

  .text-left,
  .text-right {
  font-size: clamp(3.5rem, 5rem + 0.5vw, 9rem);
  }
}

/* For screens <= 1280px */
@media (max-width: 1280px) {
  .nav-center {
  gap: clamp(15px, 1.5625rem + 0.25vw, 45px);
  transform: translateX(clamp(180px, 18.75rem + 3vw, 540px));
  }

  .nav-center a {
  font-size: clamp(7px, 0.75rem + 0.12vw, 22px);
  }

  .search-input {
  width: clamp(150px, 15.625rem + clamp(8px, 2.5vw, 48px), 450px);
  height: clamp(22px, 2.25rem + clamp(1px, 0.36vw, 7px), 65px);
  font-size: clamp(7px, 0.6875rem + 0.11vw, 20px);
  right: clamp(7px, 0.75rem + 0.12vw, 22px);
  top: clamp(4px, 0.4375rem + 0.07vw, 13px);
  }

  .img-container {
  width: clamp(160px, 50vw, 960px);
  height: clamp(240px, 50vh, 540px);
  }

  .text-left,
  .text-right {
  font-size: clamp(1.4rem, 2rem + 0.5vw, 3.6rem);
  }
}

/* For screens <= 1024px (Small laptops, large tablets) */
@media (max-width: 1024px) {
  nav {
  width: 87%;
  }

  .nav-center {
  gap: clamp(12px, 1.25rem + 0.2vw, 36px);
  font-size: clamp(7px, 0.6875rem + 0.11vw, 20px);
  transform: translateX(clamp(150px, 15.625rem + 2.5vw, 450px));
  }

  .nav-center a {
  font-size: clamp(7px, 0.6875rem + 0.11vw, 20px);
  }

  .search-input {
  width: clamp(132px, 13.75rem + clamp(7px, 2.2vw, 42px), 396px);
  height: clamp(20px, 2.125rem + clamp(1px, 0.34vw, 7px), 61px);
  font-size: clamp(6px, 0.625rem + 0.1vw, 18px);
  right: clamp(6px, 0.625rem + 0.1vw, 18px);
  top: clamp(4px, 0.375rem + 0.06vw, 11px);
  }

  .img-container {
  width: clamp(192px, 60vw, 1152px);
  height: clamp(288px, 60vh, 648px);
  }

  .img-container img {
  width: 100%;
  height: 100%;
  display: block;
  }

  .text-left,
  .text-right {
  font-size: clamp(5.6rem, 8rem + 0.5vw, 14.4rem);
  margin: 0 clamp(6px, 0.625rem + clamp(0px, 0.1vw, 2px), 18px);
  }
}

/* For screens >= 1920px (Large desktops) */
@media (min-width: 1920px) {
  nav {
  width: 90%;
  }

  .nav-center {
  gap: clamp(30px, 3.125rem + 0.5vw, 90px);
  font-size: clamp(9px, 0.9375rem + 0.15vw, 27px);
  transform: translateX(clamp(330px, 34.375rem + 5.5vw, 990px));
  }

  .nav-center a {

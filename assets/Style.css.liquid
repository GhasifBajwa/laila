@font-face {
  font-family: "GT Cinetype Trial";
  src: url("{{ 'GT-Cinetype-Regular.woff2' | asset_url }}") format("woff2");
}

@font-face {
  font-family: "NewEdge666";
  src: url("{{ 'QuackeyblurRegularDemo-drJ26.otf' | asset_url }}") format("opentype");
}

@font-face {
  font-family: "CenturySchoolbook";
  src: url("{{ 'SCHLBKB.TTF' | asset_url }}") format("truetype");
}

@font-face {
  font-family: "FiraMono";
  src: url("{{ 'FiraMono-Regular.ttf' | asset_url }}") format("truetype");
}

body {
  margin: 0;
  padding: 0;
  font-size: 16px; /* Base font size for scaling */
}

nav {
  position: fixed;
  width: 90%;
  max-width: 1200px; /* Optional: Maximum width for large screens */
  height: calc(3.75rem * 0.9); /* Scale height responsively */
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 1000;
  padding: 0 1rem; /* Add some padding */
}

.logo {
  width: calc(6.4rem * 0.9); /* Scale width responsively */
  height: calc(2.85rem * 0.9); /* Scale height responsively */
  margin-left: calc(0.625rem * 0.9);
  margin-top: calc(0.625rem * 0.9);
}

.nav-center {
  display: flex;
  gap: min(2.5rem, 5vw); /* Responsive gap */
  font-size: clamp(0.75rem, 1.2vw, 1rem); /* Responsive font size */
  text-transform: uppercase;
  letter-spacing: 0.03125rem; /* Scaled letter-spacing */
  margin-left: auto; /* Push to the right */
  margin-right: 1rem; /* Add some spacing */
}

.nav-center a {
  text-decoration: none;
  color: #000;
  font-weight: 500;
  font-family: GT Cinetype Trial;
  line-height: 1.5rem; /* Scale line height */
}

.nav-center a:hover {
  color: #999999 !important;
}

.nav-icons {
  display: flex;
  gap: min(1.5rem, 3vw); /* Responsive gap */
  height: calc(1.16rem * 0.9); /* Scale height responsively */
  width: calc(1.2rem * 0.9); /* Scale width responsively */
  color: #000;
  cursor: pointer;
}

.search-input {
  position: absolute;
  top: calc(0.625rem * 0.9);
  right: 1rem;
  width: clamp(10rem, 20vw, 22.7rem); /* Responsive width */
  height: calc(2.625rem * 0.9);
  padding: 0 0.5rem; /* Adjusted padding */
  font-size: 0.7rem;
  font-family: GT Cinetype Trial;
  font-weight: 900;
  background-color: #EDEDEF;
  border: 1px solid #EDEDEF !important;
  display: none;
  opacity: 0;
  transform: translateX(100%);
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.search-input.visible {
  opacity: 1;
  transform: translateX(0);
}

.hero-wrapper {
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.hero {
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.img-container {
  width: clamp(50vw, 60vw, 80vw); /* Scale width responsively */
  height: clamp(40vh, 60vh, 80vh); /* Scale height responsively */
  transition: transform 0.1s ease-out;
  transform: scale(1);
  overflow: hidden;
}

.img-container img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.hero-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 5;
  pointer-events: none;
  font-family: GT Cinetype Trial;
  flex-direction: column; /* Stack text on smaller screens */
}

.text-left,
.text-right {
  font-size: clamp(2rem, 5vw, 3rem); /* Responsive font size */
  font-weight: 800;
  color: white;
  opacity: 0;
  transition: all 0.5s ease-out;
  white-space: nowrap;
}

.text-left {
  transform: translateX(-100%);
  margin-right: 1rem;
}

.text-right {
  transform: translateX(100%);
  margin-left: 1rem;
}

.active .text-left {
  transform: translateX(0);
  opacity: 1;
}

.active .text-right {
  transform: translateX(0);
  opacity: 1;
}

.spacer {
  height: 100vh;
}

/* Updated Second Section Styles */
.second-section {
  position: relative;
  height: 200vh; /* Increased height to allow scrolling */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 0 5%; /* Use percentage for padding */
}

.collection-header {
  position: sticky;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  text-align: center;
  background: transparent; /* Optional: to ensure text readability */
  padding: 1rem; /* Use rem for padding */
}

.collection-label {
  text-align: start;
  margin-left: -10%; /* Use percentage for margin */
  font-family: GT Cinetype Trial;
  font-size: clamp(0.8rem, 1.2vw, 1rem); /* Responsive font size */
  font-weight: 900;
  color: #333;
  letter-spacing: -0.0625rem; /* Scaled letter-spacing */
  margin-bottom: 0.5rem; /* Use rem for margin */
}

.heading1 img {
  width: clamp(15rem, 25vw, 20rem); /* Responsive width */
  height: auto;
  margin-bottom: 1rem; /* Use rem for margin */
  object-fit: cover;
}

.heading2 img {
  width: clamp(20rem, 40vw, 30rem); /* Responsive width */
  height: auto;
  margin-bottom: 1rem; /* Use rem for margin */
  object-fit: cover;
}

.heading3 img {
  width: clamp(25rem, 50vw, 40rem); /* Responsive width */
  height: auto;
  margin-bottom: 1rem; /* Use rem for margin */
  object-fit: cover;
}

.heading4 img {
  width: clamp(15rem, 30vw, 25rem); /* Responsive width */
  height: auto;
  margin-bottom: 1rem; /* Use rem for margin */
  object-fit: cover;
}

.collection-subtitle {
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: GT Cinetype Trial;
  gap: 1rem; /* Use rem for gap */
  font-size: clamp(0.8rem, 1.2vw, 1rem); /* Responsive font size */
  letter-spacing: -0.0625rem; /* Scaled letter-spacing */
  line-height: 1.875rem; /* Use rem for line height */
  font-weight: 400;
  color: #333;
  margin-bottom: 2rem; /* Use rem for margin */
  flex-wrap: wrap; /* Allow text to wrap */
  text-align: center;
}

.single-image-container {
  position: relative;
  width: 80%;
  max-width: 800px;
  height: auto;
  max-height: 400px;
  margin: 10vh auto; /* Adjust margins */
  z-index: 1;
}

.single-image-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.collection-description {
  max-width: 80%;
  margin: 2rem auto 0;
  font-size: clamp(1rem, 2vw, 1.25rem); /* Responsive font size */
  font-weight: 500;
  color: #333;
  text-align: center;
  line-height: 1.2;
  z-index: 0;
  font-family: CenturySchoolbook;
}

.extarnal-section {
  position: relative;
  height: 200vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 5%; /* Use percentage for padding */
}

.extarnal-text {
  position: sticky;
  top: 25%;
  transform: translateX(0); /* Remove fixed translation */
  z-index: 2;
  width: 90%;
  max-width: 600px;
  text-align: center;
}

.extarnal-text .img1 img,
.extarnal-text .img2 img,
.extarnal-text .img3 img {
  width: 100%;
  max-width: 409px;
  height: auto;
  object-fit: cover;
  margin: 0 auto 1rem;
  display: block;
}

.extarnal-text h2 {
  font-size: 0.75rem;
  font-weight: 400;
  letter-spacing: 0.09375rem; /* Scaled letter-spacing */
  text-transform: uppercase;
  margin-bottom: 1.5rem; /* Use rem for margin */
  font-family: GT Cinetype Trial;
}

.extarnal-text p {
  font-size: clamp(1rem, 2vw, 1.125rem); /* Responsive font size */
  line-height: 1.6;
  margin-bottom: 1.5rem; /* Use rem for margin */
  max-width: 100%;
  margin-left: auto;
  margin-right: auto;
  font-family: CenturySchoolbook;
}

.extarnal-text .button1 button,
.extarnal-text .button2 button,
.extarnal-text .button3 button {
  background: transparent;
  border: 1px solid #000;
  width: auto;
  min-width: 6rem;
  height: 2.3125rem; /* Use rem for height */
  padding: 0.5rem 1rem;
  font-family: GT Cinetype Trial;
  font-size: 0.875rem;
  font-weight: 400;
  cursor: pointer;
  transition: background 0.3s ease, color 0.3s ease;
  margin: 0.5rem;
}

.extarnal-text button:hover {
  background: #111;
  color: #fff;
}

.extarnal-image {
  transform: translateX(0);
  margin-top: 2rem;
  width: 80%;
  max-width: 525px;
}

.extarnal-image img {
  width: 100%;
  height: auto;
  object-fit: cover;
}

.last-section {
  font-family: "Helvetica Neue", sans-serif;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #000;
  padding: 2rem 5%; /* Percentage-based padding */
}

.img4 img,
.img5 img {
  width: 80%;
  max-width: 400px;
  height: auto;
  object-fit: cover;
  margin-bottom: 1rem;
  margin-left: 0;
}

.subheading {
  margin-top: 1rem;
  font-size: clamp(1rem, 2vw, 1.25rem); /* Responsive font size */
  font-weight: 400;
  line-height: 1.2;
  text-align: center;
  width: 100%;
  max-width: 578px;
  font-family: CenturySchoolbook;
  letter-spacing: 0.125rem;
}

.button-container {
  margin-top: 1rem;
  display: flex;
  justify-content: center;
  width: 100%;
  margin-left: 0;
}

.button {
  font-size: 0.875rem;
  font-family: GT Cinetype Trial;
  font-weight: 400;
  border: 1px solid #000;
  background-color: transparent;
  cursor: pointer;
  transition: background 0.3s;
  padding: 0.5rem 1rem;
}

.button:hover {
  background-color: #000;
  color: #fff;
}

.image {
  margin-top: 2rem;
  width: 100%;
  max-width: 627px;
  height: auto;
  object-fit: cover;
  margin-bottom: 2rem;
}

.footer {
  margin-top: 1.5625rem;
  background-color: #e7e7e7;
  padding: 2rem 5%; /* Percentage-based padding */
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  font-size: 0.75rem;
  font-family: monospace;
}

.footer-column {
  flex: 1;
  min-width: 10rem;
  margin-bottom: 1rem;
}

.footer-column h4 {
  margin: 0 0 0.625rem;
  font-weight: 400;
  font-size: 0.875rem;
  line-height: 1.5rem;
  letter-spacing: -0.035rem;
  font-family: FiraMono;
}

.footer-column ul {
  list-style: none;
  padding: 0;
  margin: 0;
  font-weight: 400;
  font-size: 0.875rem;
  line-height: 1.5rem;
  letter-spacing: -0.035rem;
  font-family: FiraMono;
}

.footer-column ul li {
  margin: 0.3125rem 0;
  font-weight: 400;
  font-size: 0.875rem;
  line-height: 1.5rem;
  letter-spacing: -0.035rem;
  font-family: FiraMono;
}

.footer-column p {
  margin: 0.3125rem 0;
  font-weight: 400;
  font-size: 0.875rem;
  line-height: 1.5rem;
  letter-spacing: -0.035rem;
  font-family: FiraMono;
}

.social-icons {
  display: flex;
  gap: 0.625rem;
  margin-top: 0.625rem;
}

.social-icons img {
  width: 1.8125rem;
  height: 1.8125rem;
}

.social-icons .group {
  margin-top: 0.125rem;
  width: 2.125rem;
  height: 1.5rem;
}

/* Shope page */

.Filter-nav {
  padding-top: 4.375rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 1rem; /* Add left padding */
  padding-right: 1rem; /* Add right padding */
}

.Filter-nav-links {
  margin-left: 0;
  list-style: none;
  display: flex;
  gap: 1.5rem;
  padding: 0;
}

.Filter-nav-links li a {
  text-decoration: none;
  color: #000;
  font-weight: 900;
  font-size: 0.875rem;
  font-family: GT Cinetype Trial;
  line-height: 1.5rem;
  letter-spacing: -0.0625rem;
}

.filter {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.5rem;
  margin-top: 0.5rem;
  padding-right: 1rem; /* Add right padding */
}

.filter span {
  margin-top: 0;
  margin-right: 0.5rem;
  font-weight: 900;
  font-size: 0.875rem;
  font-family: GT Cinetype Trial;
  line-height: 1.5rem;
  letter-spacing: -0.0625rem;
}

.filter img {
  height: 2.9375rem;
  width: 2.0625rem;
  object-fit: cover;
}

.name {
  font-weight: 900;
  font-size: 0.875rem;
  font-family: GT Cinetype Trial;
  margin-top: 0.5rem;
  line-height: 1.5rem;
  letter-spacing: -0.0625rem;
}

.price {
  font-weight: 900;
  font-size: 0.875rem;
  font-family: GT Cinetype Trial;
  line-height: 1.5rem;
  letter-spacing: -0.0625rem;
}

.product img {
  width: 100%;
  aspect-ratio: 365 / 340;
  object-fit: cover;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  gap: 0.5rem;
  padding: 1rem;
}

.gallery_Collection {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  gap: 1rem;
  text-align: center;
  padding: 2rem;
}

.item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.item1 img,
.item2 img,
.item3 img,
.item4 img,
.item5 img,
.item6 img {
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1; /* Adjust as needed */
  object-fit: cover;
  border: 1px solid #ccc;
}

.caption {
  margin-top: 0.5rem;
  font-size: 0.875rem;
  font-weight: 900;
  letter-spacing: -0.0625rem;
  font-family: GT Cinetype Trial;
  line-height: 1.5rem;
}

.section-about {
  max-width: 1000px;
  margin: 0 auto 5rem auto;
  padding-top: 5rem;
  padding-left: 1rem; /* Add left padding */
  padding-right: 1rem; /* Add right padding */
}

.story {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  align-items: center;
}

.about-img {
  width: 100%;
  max-width: 350px;
  height: auto;
}

.story-text {
  margin-top: 1rem;
  text-align: center;
}

.story-text img {
  margin-bottom: 1rem;
  width: 100%;
  max-width: 200px;
  height: auto;
}

.story-text p {
  font-size: clamp(1rem, 2vw, 1.25rem); /* Responsive font size */
  max-width: 100%;
  font-weight: 500;
  font-family: CenturySchoolbook;
  line-height: 1.2;
}

.timeless {
  max-width: 700px;
  margin: 0 auto;
  margin-top: 5rem;
  text-align: center;
}

.timeless img {
  margin-left: 0;
  width: 100%;
  max-width: 250px;
  height: auto;
  margin-bottom: 1rem;
}

.timeless p {
  font-size: clamp(1rem, 2vw, 1.25rem); /* Responsive font size */
  max-width: 100%;
  font-weight: 500;
  font-family: CenturySchoolbook;
  line-height: 1.2;
  text-align: center;
}

/* Modal Sidebar */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.5);
  display: none;
  z-index: 9;
}

.cart-modal {
  position: fixed;
  top: 0;
  right: -100%; /* Hidden off-screen by default */
  width: 90%; /* Take up most of the screen on mobile */
  max-width: 400px; /* Limit the maximum width on larger screens */
  height: 100vh;
  background: #fff;
  box-shadow: -2px 0 10px rgba(0, 0, 0, 0.2);
  transition: right 0.3s ease;
  z-index: 10;
  display: flex;
  flex-direction: column;
  font-size: 0.8125rem; /* 13px */
}

.cart-modal.open {
  right: 0;
}

.overlay.show {
  display: block;
}

.cart-header,
.cart-footer {
  padding: 0.625rem 0.9375rem; /* 10px 15px */
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #000;
}

.cart-header {
  font-weight: bold;
  text-transform: uppercase;
  font-family: GT Cinetype Trial;
}

.cart-body {
  flex: 1;
  overflow-y: auto;
  padding: 0.625rem; /* 10px */
}

.cart-item {
  display: flex;
  border-bottom: 1px solid #000;
  margin-bottom: 0.625rem; /* 10px */
}

.cart-item img {
  width: 40%; /* Adjust width */
  object-fit: cover;
}

.item-info {
  padding: 0.625rem; /* 10px */
  width: 60%; /* Adjust width */
}

.item-info p {
  margin: 0.125rem 0; /* 2px 0 */
  font-family: GT Cinetype Trial;
}

.remove {
  color: red;
  font-family: GT Cinetype Trial;
  font-size: 0.875rem; /* 14px */
  font-weight: 900;
  cursor: pointer;
  margin-top: 0.3125rem; /* 5px */
}

.checkout-section {
  border-top: 1px solid #000;
  padding: 0.9375rem; /* 15px */
}

.checkout-section .total-label {
  font-family: GT Cinetype Trial;
  font-size: 0.875rem; /* 14px */
  font-weight: 900;
  text-transform: uppercase;
  color: #666;
}

.checkout-section .total-amount {
  font-family: GT Cinetype Trial;
  font-size: 0.875rem; /* 14px */
  font-weight: 900;
  margin-bottom: 0.625rem; /* 10px */
}

.checkout-button {
  background-color: #e94f35;
  color: white;
  border: none;
  width: 100%;
  padding: 0.75rem; /* 12px */
  font-family: GT Cinetype Trial;
  font-size: 0.875rem; /* 14px */
  font-weight: 900;
  cursor: pointer;
  text-transform: uppercase;
}

.open-bag {
  cursor: pointer;
}

.x-close {
  color: red;
  font-family: GT Cinetype Trial;
  font-size: 0.875rem; /* 14px */
  font-weight: 900;
  cursor: pointer;
}

/* Media Queries for Responsiveness (Mobile First) */
@media (min-width: 576px) {
  /* Small devices (landscape phones, 576px and up) */
  .nav-center {
    margin-right: 2rem;
  }

  .extarnal-text {
    text-align: left;
  }

  .story {
    flex-direction: row;
    align-items: flex-start;
    text-align: left;
  }

  .story-text {
    margin-top: 5rem;
  }
}

@media (min-width: 768px) {
  /* Medium devices (tablets, 768px and up) */
  .nav-center {
    gap: min(3rem, 4vw);
  }

  .extarnal-image {
    transform: translateX(-20%); /* Restore some translation for larger screens */
  }

  .footer {
    padding: 2rem;
  }
}

@media (min-width: 992px) {
  /* Large devices (desktops, 992px and up) */
  .nav-center {
    gap: min(4rem, 3vw);
  }

  .img-container {
    width: clamp(50vw, 60vw, 70vw);
    height: clamp(40vh, 60vh, 70vh);
  }
}

@media (min-width: 1200px) {
  /* Extra large devices (large desktops, 1200px and up) */
  .nav-center {
    gap: min(5rem, 2vw);
  }

  .gallery_Collection {
    grid-template-columns: repeat(3, 1fr);
  }
}
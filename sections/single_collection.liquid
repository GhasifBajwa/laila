<style>
  @font-face {
    font-family: "CenturySchoolbook";
    src: url("{{ 'SCHLBKB.TTF' | asset_url }}") format("truetype");
  }
  .collection_heading {
    padding: 20px;
  }

  .collection_heading img {
    height: 20px;
    width: 250px;
    /* object-fit: cover; */
  }
  .collection_heading p {
  max-width: 90%; /* Converted from 720px at base 16px: 720 / 16 = 45rem -> using % for responsiveness */
  margin-top: 1.875rem; /* Converted from 30px */
  font-size: 0.875rem; /* Converted from 14px */
  font-weight: 500;
  letter-spacing: -4%;
  font-family: CenturySchoolbook, sans-serif; /* Added sans-serif as fallback */
  line-height: 1.25rem; /* Converted from 20px */
}

  .filter-container {
  display: inline-block;
  font-family: GT Cinetype Trial, sans-serif;
  font-size: 0.875rem; /* 14px / 16px */
  position: relative;
}

.filter {
  display: flex;
  align-items: center;
  cursor: pointer;
  user-select: none;
}

.filter-dropdown {
  display: none;
  position: absolute;
  top: 2.5rem; /* 40px / 16px */
  right: 1.25rem; /* 20px / 16px */
  padding: 0.375rem 0.5rem; /* 6px 8px / 16px */
  font-family: GT Cinetype Trial, sans-serif;
  font-size: 0.875rem; /* 14px / 16px */
  font-weight: 900;
  background: white;
  z-index: 100;
  min-width: 10rem; /* Minimum width for readability */
  box-shadow: 0 2px 5px rgba(0,0,0,0.2);
}

.filter-dropdown.visible {
    display: block;
}

/* Media queries for responsiveness */
@media (max-width: 768px) { /* Example breakpoint */
    .collection_heading p {
        font-size: 0.75rem;
        line-height: 1rem;
    }
}

@media (max-width: 600px) { /* Example breakpoint */
    .collection_heading p {
        font-size: 0.625rem;
        line-height: 0.875rem;
    }
  .filter-container {
        width: 100%;
      margin-left: 15px;
    }

    .filter-dropdown {
        width: 90%;
        /* left: 5%; */
        right: 33%;
    }
  .filter span{
    display: none;
  }
  .filter {
  display: flex;
  align-items: center;
  justify-content: start;
}
}

/* Zoom level adjustments (optional - you can add more specific styles if needed) */
@media screen and (min-resolution: 192dpi) { /* For 200% zoom and higher dpi screens */
  .collection_heading p {
      letter-spacing: -2%; /* Adjust letter spacing to compensate for zoom */
  }
}
</style>


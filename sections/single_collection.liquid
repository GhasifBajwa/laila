<script>
    const filter_Toggle = document.getElementById("filter_Toggle");
    const filter_Dropdown = document.getElementById("filter_Dropdown");
  
    filter_Toggle.addEventListener("click", () => {
      filter_Dropdown.classList.toggle("visible");
    });
  
    // Optional: Close dropdown if clicking outside
    document.addEventListener("click", (e) => {
      if (
        !filter_Toggle.contains(e.target) &&
        !filter_Dropdown.contains(e.target)
      ) {
        filter_Dropdown.classList.remove("visible");
      }
    });
</script>